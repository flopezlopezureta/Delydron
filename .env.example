NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=dronecontrol
DB_PASSWORD=changeme
DB_NAME=dronecontrol
DB_SSL=false

JWT_SECRET=changeme-long-random-string
JWT_EXPIRES_IN=8h

SYSTEM_TZ=America/Santiago
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

DRONE_ADAPTER=simulated
SIM_TICK_MS=1000
SIM_DEFAULT_SPEED_MPS=12
SIM_BATTERY_DRAIN_PCT_PER_MIN=1.5

# Recovery hatch, normally unset — see bootstrapAdminFromEnv() in
# services/userService.js. Set both, redeploy once, log in, then remove
# both again (leaving them set resets this account's password on every
# restart, silently undoing any later change made through the app).
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
